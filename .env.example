# Server Configuration
PORT=5001
NODE_ENV=development
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/rayzon_p2p?retryWrites=true&w=majority
MONGODB_DB_NAME=rayzon_p2p_enterprise_modular_server
# Optional override when a VPN or local DNS proxy blocks Atlas SRV lookups
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# AWS S3 Configuration (for document storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=rayzon-p2p-documents

# Vite Client API Configuration
VITE_API_URL=http://localhost:5001

# Transactional email
# Keep false for development/testing with real user addresses. Set true only when ready to deliver mail.
MAIL_ENABLED=false
MAIL_HOST=your-smtp-host
MAIL_PORT=2525
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Rayzon P2P
SAP_BASE_URL=https://my420266-api.s4hana.cloud.sap
SAP_USERNAME=
SAP_PASSWORD=
SAP_TIMEOUT_MS=30000
SAP_MAX_PAGES=500
SAP_SYNC_ENABLED=false
SAP_SYNC_INTERVAL_MINUTES=60
